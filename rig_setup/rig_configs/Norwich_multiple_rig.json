{
    "name": "Norwich Rig (2 pipettes)",
    "schema_version": 2,
    "pipette_count": 2,
    "calibration_file": "Norwich_cal.yaml",
    "patch_file": "Norwich_patch.yaml",
    "protocol_file": "Norwich_protocol.yaml",
    "calibration": {
        "pipette_detector_model": null,
        "pipette_focuser_model": null
    },
    "ai_features": {
        "enabled": true
    },
    "devices": {
        "stage_controller": {
            "class": "patcherbot.devices.manipulator.scientificaSerial.ScientificaSerialNoEncoder",
            "params": {
                "serial": {
                    "port": "COM12",
                    "baudrate": 9600
                },
                "max_speed": 100000,
                "max_accel": 1000,
                "polling_freq": 100
            }
        },
        "pipette_controller": [
            {
                "class": "patcherbot.devices.manipulator.scientificaSerial.ScientificaSerialNoEncoder",
                "params": {
                    "serial": {
                        "port": "COM8",
                        "baudrate": 9600
                    },
                    "max_speed": 100000,
                    "max_accel": 1000,
                    "polling_freq": 100
                }
            },
            {
                "class": "patcherbot.devices.manipulator.scientificaSerial.ScientificaSerialNoEncoder",
                "params": {
                    "serial": {
                        "port": "COM7",
                        "baudrate": 9600
                    },
                    "max_speed": 100000,
                    "max_accel": 1000,
                    "polling_freq": 100
                }
            }
        ],
        "camera": {
            "class": "patcherbot.devices.camera.pcocamera.PcoCamera",
            "params": {
                "width": 1280,
                "height": 1280
            }
        },
        "pipette_camera": [
            {
                "class": "patcherbot.devices.camera.camera.FakeCamera",
                "params": {
                    "image_z": 0,
                    "paramecium": false
                }
            },
            {
                "class": "patcherbot.devices.camera.camera.FakeCamera",
                "params": {
                    "image_z": 0,
                    "paramecium": false
                }
            }
        ],
        "cell_sorter_controller": {
            "class": "patcherbot.devices.cellsorter.CellSorter.FakeCellSorterController",
            "params": {}
        },
        "cell_sorter_manipulator": {
            "class": "patcherbot.devices.cellsorter.CellSorter.FakeCellSorterManip",
            "params": {}
        },
        "daq": {
            "class": "patcherbot.devices.amplifier.DAQ.NiDAQ",
            "params": {
                "channels": [
                    {
                        "read": "Dev1/ai19",
                        "resp": "Dev1/ai17",
                        "cmd": "Dev1/ao0"
                    },
                    {
                        "read": "Dev1/ai23",
                        "resp": "Dev1/ai21",
                        "cmd": "Dev1/ao3"
                    }
                ]
            }
        },
        "amplifier": {
            "class": "patcherbot.devices.amplifier.multiclamp.MultiClampAmplifier",
            "params": {
                "channels": [
                    1,
                    2
                ]
            }
        },
        "pressure": [
            {
                "class": "patcherbot.devices.pressurecontroller.SerialPressureController.SerialPressureController",
                "params": {
                    "channel": 1,
                    "controllerSerial": {
                        "port": "COM4",
                        "baudrate": 9600,
                        "timeout": 0
                    },
                    "readerSerial": {
                        "port": "COM3",
                        "baudrate": 9600,
                        "timeout": 0
                    },
                    "validProducts": [
                        "USB Serial"
                    ],
                    "validVIDs": [
                        6790,
                        1027
                    ],
                    "serialCmdTimeout": 1.0
                }
            },
            {
                "class": "patcherbot.devices.pressurecontroller.BasePressureController.FakePressureController",
                "params": {}
            }
        ],
        "lamp": {
            "class": "patcherbot.devices.lamp.lamp.FakeLamp",
            "params": {}
        },
        "laser": {
            "class": "patcherbot.devices.laser.laser.FakeLaser",
            "params": {}
        }
    }
}
