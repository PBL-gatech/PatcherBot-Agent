                                                                             "port":  "COM5",
                                                                             "baudrate":  9600,
                                                                             "timeout":  0
                                                                         },
                                                    "readerSerial":  {
                                                                         "port":  "COM4",
                                                                         "baudrate":  9600,
                                                                         "timeout":  0
