                                                                           "baudrate":  9600,
                                                                           "timeout":  1
                                                                       },
                                                            "max_speed":  10000,
                                                            "max_accel":  1000,
                                                            "polling_freq":  100
                                                        }
                                         },
                    "pipette_controller":  {
                                               "class":  "patcherbot.devices.manipulator.sensapexWrapper.SensapexManip",
