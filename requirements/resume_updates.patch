+        """Read the envelope; the interface validates physical conditions."""
+        with (self.session_dir / "experiment_state.json").open(encoding="utf-8") as handle:
+            state = json.load(handle, parse_constant=self._reject_json_constant)
+        required = {"schema_version", "saved_at", "experiment", "conditions", "sources"}
+        if not isinstance(state, dict) or set(state) != required:
+            raise ValueError("Invalid experiment-state structure.")
+        if type(state["schema_version"]) is not int or state["schema_version"] != 1:
+            raise ValueError("Unsupported experiment-state version.")
+        if not isinstance(state["saved_at"], str):
+            raise ValueError("Invalid experiment-state timestamp.")
+        datetime.fromisoformat(state["saved_at"])
+        for key in ("experiment", "conditions", "sources"):
+            if not isinstance(state[key], dict):
+                raise ValueError(f"Invalid experiment-state {key}.")
+        return state
