+    def write_experiment_state(self, conditions, experiment, sources):
+        """Atomically persist validated, JSON-native experiment conditions."""
+        state = {
+            "schema_version": 1,
+            "saved_at": self._timestamp(),
+            "experiment": dict(experiment),
+            "conditions": dict(conditions),
+            "sources": dict(sources),
+        }
