+            header = None
+            if line.startswith("[") and "] " in line:
+                timestamp, candidate = line[1:].split("] ", 1)
+                if candidate in {"DETAILS", "NOTE", "SNAPSHOT", "STATE TALLY", "ORIGIN X", "ORIGIN Y"}:
+                    try:
+                        datetime.fromisoformat(timestamp)
+                    except ValueError:
+                        pass
+                    else:
+                        header = candidate
+            if header is not None:
+                if entry_type is not None:
+                    yield entry_type, body
+                entry_type, body = header, []
+            elif entry_type is not None:
+                body.append(line)
+        if entry_type is not None:
+            yield entry_type, body
