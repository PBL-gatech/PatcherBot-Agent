+            details = {}
+            for line in body:
+                for prefix, key in prefixes.items():
+                    if line.startswith(prefix):
+                        details[key] = line[len(prefix):]
+            if set(details) != set(prefixes.values()) or not details["experiment_name"]:
+                raise ValueError("Incomplete saved experiment details.")
+        if details is None:
