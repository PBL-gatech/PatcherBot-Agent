+                                           flip_x=False, flip_y=False, rotate=0)
+        interface.microscope = SimpleNamespace(floor_Z=42.0, up_direction=-1, axes=[2], axis=2, units_per_um=5.0)
+        interface.tare_stage = np.array([11., None, 4.], dtype=object)
