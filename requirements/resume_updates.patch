+"""Hardware-free regressions for saved experiment restoration.
+
+Compile production class methods without hardware imports/constructors. This
+keeps tests runnable on development computers without NI or microscope drivers.
+"""
+import ast
+from copy import deepcopy
+from datetime import datetime
+import importlib.util
+import json
+import os
+from pathlib import Path
+import pickle
+from types import SimpleNamespace
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def source_class(path, name):
+    tree = ast.parse((ROOT / path).read_text(encoding="utf-8-sig"))
+    node = next(item for item in tree.body if isinstance(item, ast.ClassDef) and item.name == name)
+    body = []
+    for item in node.body:
+        if isinstance(item, ast.FunctionDef) and item.name != "__init__":
+            item.decorator_list = [d for d in item.decorator_list
+                                   if isinstance(d, ast.Name) and d.id in ("staticmethod", "classmethod")]
+            item.returns = None
+            for argument in item.args.args + item.args.kwonlyargs:
+                argument.annotation = None
+            body.append(item)
+        elif isinstance(item, ast.Assign) and all(isinstance(t, ast.Name) and t.id.isupper() for t in item.targets):
+            body.append(item)
+    node.bases = []
+    node.keywords = []
+    node.decorator_list = []
+    node.body = body
+    namespace = dict(np=np, deepcopy=deepcopy, datetime=datetime, json=json, os=os,
+                     pickle=pickle, Path=Path)
+    exec(compile(ast.fix_missing_locations(ast.Module(body=[node], type_ignores=[])), path, "exec"), namespace)
+    return namespace[name]
+
+
+spec = importlib.util.spec_from_file_location("reload_logger", ROOT / "patcherbot/utils/experiment_book.py")
+logger_module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(logger_module)
+Logger = logger_module.ExperimentBookLogger
+
+
+def origin(axis, value):
+    return dict(axis=axis, origin_id=("a" if axis == "x" else "b") * 32,
+                saved_at="2026-09-28T12:00:00+00:00", image_path=f"images/{axis}.png",
+                origins_um={"x": value if axis == "x" else None,
+                            "y": value if axis == "y" else None},
+                stage_xyz_um=[value, value, 30.0],
+                experiment={"experiment_name": "slice A"})
+
+
+class LoggerTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.logger = Logger(self.temp.name)
+        self.logger.write_details({"experiment_name": "slice A"})
+
+    def test_roundtrip_uses_existing_folder_and_missing_sources_are_provenance(self):
+        saved = self.logger.write_experiment_state({"origin_records": {"x": origin("x", 13)}},
+                                                  {"experiment_name": "slice A"},
+                                                  {"calibration": "missing/calibration.pickle"})
+        opened = Logger.open_existing(self.logger.session_dir)
+        self.assertEqual(opened.session_dir, self.logger.session_dir.resolve())
+        self.assertEqual(opened.read_experiment_state(), saved)
+        self.assertEqual(len(list(Path(self.temp.name).iterdir())), 1)
+
+    def test_interrupted_replace_preserves_previous_snapshot(self):
+        saved = self.logger.write_experiment_state({"value": 1}, {}, {})
+        with patch.object(logger_module.os, "replace", side_effect=OSError("interrupted")):
+            with self.assertRaises(OSError):
+                self.logger.write_experiment_state({"value": 2}, {}, {})
+        self.assertEqual(self.logger.read_experiment_state(), saved)
+        self.assertEqual(list(self.logger.session_dir.glob(".experiment_state-*.tmp")), [])
+
+    def test_invalid_envelopes_are_rejected(self):
+        state = self.logger.write_experiment_state({}, {}, {})
+        invalid = []
+        for key, value in (("schema_version", 999), ("saved_at", "bad date"),
+                           ("conditions", []), ("experiment", []), ("sources", [])):
+            item = deepcopy(state)
+            item[key] = value
+            invalid.append(item)
+        invalid.append({**state, "conditions": {"bad": float("nan")}})
+        for item in invalid:
+            with self.subTest(item=item):
+                (self.logger.session_dir / "experiment_state.json").write_text(json.dumps(item), encoding="utf-8")
+                with self.assertRaises((ValueError, TypeError)):
+                    self.logger.read_experiment_state()
+
+    def test_legacy_origins_use_latest_valid_record_per_axis(self):
+        self.logger.write_origin(origin("x", 10))
+        y = self.logger.write_origin(origin("y", 20))
+        x = self.logger.write_origin(origin("x", 30))
+        before = self.logger.log_path.read_bytes()
+        self.assertEqual(self.logger.read_saved_origins(), {"x": x, "y": y})
+        self.assertEqual(self.logger.log_path.read_bytes(), before)
+
+    def test_nonfinite_write_does_not_replace_valid_snapshot(self):
+        saved = self.logger.write_experiment_state({}, {}, {})
+        with self.assertRaises(ValueError):
+            self.logger.write_experiment_state({"bad": float("inf")}, {}, {})
+        self.assertEqual(self.logger.read_experiment_state(), saved)
