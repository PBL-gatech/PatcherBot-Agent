+"""Exercise production reload handlers with Qt widgets and no hardware imports."""
+import ast
+import os
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock
+
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+from PyQt5 import QtCore, QtWidgets
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def production_method(path, method_name, namespace):
+    tree = ast.parse((ROOT / path).read_text(encoding="utf-8-sig"))
+    method = next(method for cls in tree.body if isinstance(cls, ast.ClassDef)
+                  for method in cls.body
+                  if isinstance(method, ast.FunctionDef) and method.name == method_name)
+    method.decorator_list = []
+    module = ast.fix_missing_locations(ast.Module(body=[method], type_ignores=[]))
+    exec(compile(module, path, "exec"), namespace)
+    return namespace[method_name]
+
+
+class ReloadUiTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.app = QtWidgets.QApplication.instance() or QtWidgets.QApplication([])
+
+    def setUp(self):
+        self.state = {
+            "experiment": {"experiment_name": "slice A", "strain_culture": "test",
+                           "gender": "", "age": ""},
+            "saved_at": "2026-09-28T20:42:11+00:00",
+            "sources": {"calibration": None, "tare": None},
+            "conditions": {"completion": dict(stage=True, pipette=True, cleaning=False),
+                           "origin_records": {"x": {"saved": True}, "y": {"saved": True}}},
+        }
+        self.logger = SimpleNamespace(read_experiment_state=Mock(return_value=self.state),
+                                      write_note=Mock())
+        self.logger_factory = SimpleNamespace(open_existing=Mock(return_value=self.logger))
+        namespace = dict(os=os, ExperimentBookLogger=self.logger_factory,
+                         QMessageBox=SimpleNamespace(Yes=1, Cancel=2, question=Mock(return_value=1)))
+        methods = {name: production_method("patcherbot/gui/patch.py", name, namespace)
+                   for name in ("_reload_experiment", "_finish_experiment_reload",
+                                "_experiment_restored", "_experiment_error")}
+        methods["start_task"] = production_method("patcherbot/gui/camera.py", "start_task", namespace)
+        self.gui = type("ReloadHarness", (QtWidgets.QWidget,), methods)()
+        gui = self.gui
+        gui.status_bar = QtWidgets.QStatusBar(gui)
+        gui.task_progress_text = QtWidgets.QLabel(gui)
+        gui.task_progress = QtWidgets.QProgressBar(gui)
+        gui.task_abort_button = QtWidgets.QPushButton(gui)
+        gui.task_success_button = QtWidgets.QPushButton(gui)
+        gui.classic_patching_tab = QtWidgets.QWidget(gui)
+        gui.classic_patching_tab.restore_experiment_display = Mock()
+        gui.experiment_book_tab = QtWidgets.QWidget(gui)
+        gui.experiment_book_tab.detail_edits = dict(self.state["experiment"])
+        gui.experiment_book_tab.activate_existing = Mock()
+        gui.experiment_book_tab._set_status = Mock()
+        gui.patch_interface = SimpleNamespace(
+            _current_controller=None,
+            restore_experiment_state=Mock(side_effect=AssertionError("Worker executed in UI")))
+        gui.pipette_interface = SimpleNamespace(_current_controller=None)
+        gui.patch_command_signal = SimpleNamespace(emit=Mock())
+        gui._queue_experiment_save = Mock()
+        gui._experiment_reloading = False
+        gui._snapshot_pending = False
+        gui._origin_busy = False
+        gui.running_task = None
+        gui.running_task_interface = None
+        gui._snapshot_timer = QtCore.QTimer(gui)
+        gui._display_position_timer = QtCore.QTimer(gui)
+        gui.classic_patching_tab.pos_update_timers = [QtCore.QTimer(gui), QtCore.QTimer(gui)]
+        self.timers = [gui._snapshot_timer, gui._display_position_timer,
+                       *gui.classic_patching_tab.pos_update_timers]
+        for timer in self.timers:
+            timer.start(60000)
+        self.request = dict(logger=self.logger, state=self.state)
+
+    def tearDown(self):
+        for timer in self.timers:
+            timer.stop()
+        self.gui.close()
+        self.gui.deleteLater()
+        self.app.processEvents()
+
+    def begin_reload(self):
+        self.gui._reload_experiment("saved-experiment")
+        self.assertTrue(self.gui._experiment_reloading)
+        self.assertEqual(self.gui.running_task, "Reloading experiment")
+
+    def assert_finished(self):
+        gui = self.gui
+        self.assertFalse(gui._experiment_reloading)
+        self.assertIsNone(gui.running_task)
+        self.assertIsNone(gui.running_task_interface)
+        self.assertTrue(gui.task_progress.isHidden())
+        for button in (gui.task_abort_button, gui.task_success_button):
+            self.assertTrue(button.isHidden())
+            self.assertFalse(button.isEnabled())
+        self.assertTrue(gui.classic_patching_tab.isEnabled())
+        self.assertTrue(gui.experiment_book_tab.isEnabled())
+        self.assertTrue(gui._display_position_timer.isActive())
+        for timer in gui.classic_patching_tab.pos_update_timers:
+            self.assertTrue(timer.isActive())
+        gui.patch_interface.restore_experiment_state.assert_not_called()
+
+    def test_reload_shows_progress_without_invalid_abort_or_success_actions(self):
+        self.begin_reload()
+        gui = self.gui
+        self.assertFalse(gui.task_progress.isHidden())
+        for button in (gui.task_abort_button, gui.task_success_button):
+            self.assertTrue(button.isHidden())
+            self.assertFalse(button.isEnabled())
+        self.assertFalse(gui.classic_patching_tab.isEnabled())
+        self.assertFalse(gui.experiment_book_tab.isEnabled())
+        self.assertTrue(all(not timer.isActive() for timer in self.timers))
+        gui.patch_command_signal.emit.assert_called_once_with(
+            gui.patch_interface.restore_experiment_state, self.request)
+        gui.patch_interface.restore_experiment_state.assert_not_called()
+
+    def test_success_removes_indicator_and_restores_gui_activity(self):
+        self.begin_reload()
+        self.gui._experiment_restored(self.request)
+        self.assert_finished()
+        self.gui.experiment_book_tab.activate_existing.assert_called_once_with(
+            self.logger, self.state["experiment"])
+        self.gui.classic_patching_tab.restore_experiment_display.assert_called_once_with(
+            self.state["conditions"]["completion"])
+        self.logger.write_note.assert_called_once()
+        self.gui._queue_experiment_save.assert_called_once()
+
+    def test_worker_error_removes_indicator_and_restores_gui_activity(self):
+        self.begin_reload()
+        self.gui._experiment_error("Saved state invalid")
+        self.assert_finished()
+        args, kwargs = self.gui.experiment_book_tab._set_status.call_args
+        self.assertIn("Saved state invalid", args[0])
+        self.assertTrue(kwargs["error"])
+
+    def assert_refresh_failure_recovers(self, operation):
+        self.begin_reload()
+        operation.side_effect = RuntimeError("Display refresh failed")
+        self.gui._experiment_restored(self.request)
+        self.assert_finished()
+        args, kwargs = self.gui.experiment_book_tab._set_status.call_args
+        self.assertIn("Display refresh failed", args[0])
+        self.assertTrue(kwargs["error"])
+
+    def test_book_activation_error_still_finishes_reload(self):
+        self.assert_refresh_failure_recovers(self.gui.experiment_book_tab.activate_existing)
+
+    def test_calibration_display_error_still_finishes_reload(self):
+        self.assert_refresh_failure_recovers(self.gui.classic_patching_tab.restore_experiment_display)
+
+    def test_note_write_failure_does_not_leave_reload_running(self):
+        self.begin_reload()
+        self.logger.write_note.side_effect = OSError("Log unavailable")
+        self.gui._experiment_restored(self.request)
+        self.assert_finished()
+        self.assertIn("Log unavailable", self.gui.experiment_book_tab._set_status.call_args.args[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
